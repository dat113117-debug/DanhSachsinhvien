    LList L;
    int kt = 0;
    Data x;

    initList(&L);

    do {
        printf("\n===== CHUONG TRINH DSLK DON SINH VIEN =====\n");
        printf("1: Them nut vao dau danh sach\n");
        printf("2: Them nut vao cuoi danh sach\n");
        printf("3: Them nut vao sau mot nut khac\n");
        printf("4: Xoa sinh vien theo ma\n");
        printf("9: Duyet danh sach\n");
        printf("0: Thoat\n");
        printf("Moi ban chon: ");

        int chon;
        scanf("%d", &chon);

        switch(chon) {
            case 1:
                printf("Nhap thong tin sinh vien:\n");
                nhap(&x);

                if(x.masv > 0)
                    insert_Head(&L, x);
                break;

            case 2:
                printf("Nhap thong tin sinh vien:\n");
                nhap(&x);

                if(x.masv > 0)
                    insert_Tail(&L, x);
                break;

            case 3: {
                int ma;

                printf("Nhap ma sinh vien can tim vi tri: ");
                scanf("%d", &ma);

                printf("Nhap thong tin sinh vien can them:\n");
                nhap(&x);

                if(x.masv > 0)
                    insert_After(&L, ma, x);
                break;
            }

            case 4: {
                int ma;

                printf("Nhap ma sinh vien can xoa: ");
                scanf("%d", &ma);

                delete_Node(&L, ma);
                break;
            }

            case 9:
                processList(L);
                break;

            case 0:
                printf("Bye bye!\n");
                kt = 1;
                break;

            default:
                printf("Lua chon khong hop le!\n");
        }

    } while(kt == 0);

    clearList(&L);

    return 0;
}
